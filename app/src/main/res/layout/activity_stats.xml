<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vb_system_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vb_topappbar_height"
        android:background="@color/vb_secondary_system_background">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/vb_space_md"
            android:paddingEnd="@dimen/vb_space_md">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lùi"
                android:src="@drawable/vb_ic_chevron_left"
                app:tint="@color/vb_accent" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/stats_title"
                android:textAppearance="@style/TextAppearance.VBoard.Headline"
                android:textColor="@color/vb_label" />
            <View android:layout_width="44dp" android:layout_height="44dp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="@dimen/vb_hairline"
            android:layout_gravity="bottom" android:background="@color/vb_separator" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md"
                android:paddingTop="@dimen/vb_space_md"
                android:paddingBottom="@dimen/vb_space_xs"
                android:textAppearance="@style/TextAppearance.VBoard.Overline"
                android:text="HÔM NAY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/vb_space_xs"
                    app:cardBackgroundColor="@color/vb_secondary_system_background"
                    app:cardCornerRadius="@dimen/vb_radius_md"
                    app:cardElevation="@dimen/vb_elevation_e1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/vb_space_md">
                        <TextView
                            android:id="@+id/sentenceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.VBoard.Display"
                            android:text="0"
                            tools:text="12" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/vb_space_2xs"
                            android:textAppearance="@style/TextAppearance.VBoard.Caption1"
                            android:text="@string/stats_sentences_created" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/vb_secondary_system_background"
                    app:cardCornerRadius="@dimen/vb_radius_md"
                    app:cardElevation="@dimen/vb_elevation_e1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/vb_space_md">
                        <TextView
                            android:id="@+id/wordCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.VBoard.Display"
                            android:text="0"
                            tools:text="8" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/vb_space_2xs"
                            android:textAppearance="@style/TextAppearance.VBoard.Caption1"
                            android:text="@string/stats_unique_words" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 7-day chart -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md"
                android:paddingTop="@dimen/vb_space_md"
                android:paddingBottom="@dimen/vb_space_xs"
                android:textAppearance="@style/TextAppearance.VBoard.Overline"
                android:text="@string/stats_7_days" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vb_space_md"
                android:layout_marginEnd="@dimen/vb_space_md"
                app:cardBackgroundColor="@color/vb_secondary_system_background"
                app:cardCornerRadius="@dimen/vb_radius_md"
                app:cardElevation="@dimen/vb_elevation_e1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/vb_space_md">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <View android:id="@+id/chartBar1" android:layout_width="0dp" android:layout_height="4dp"
                            android:layout_marginEnd="6dp" android:layout_weight="1"
                            android:background="@color/vb_accent" />
                        <View android:id="@+id/chartBar2" android:layout_width="0dp" android:layout_height="4dp"
                            android:layout_marginEnd="6dp" android:layout_weight="1"
                            android:background="@color/vb_accent" />
                        <View android:id="@+id/chartBar3" android:layout_width="0dp" android:layout_height="4dp"
                            android:layout_weight="1"
                            android:background="@color/vb_accent" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Top words -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md"
                android:paddingTop="@dimen/vb_space_md"
                android:paddingBottom="@dimen/vb_space_xs"
                android:textAppearance="@style/TextAppearance.VBoard.Overline"
                android:text="@string/stats_top_words" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vb_space_md"
                android:layout_marginEnd="@dimen/vb_space_md"
                android:layout_marginBottom="@dimen/vb_space_md"
                app:cardBackgroundColor="@color/vb_secondary_system_background"
                app:cardCornerRadius="@dimen/vb_radius_md"
                app:cardElevation="@dimen/vb_elevation_e1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/vb_space_md">
                    <TextView
                        android:id="@+id/topWords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.VBoard.Caption1"
                        android:text="Chưa có dữ liệu" />
                    <TextView
                        android:id="@+id/topWords1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.VBoard.Body" />
                    <TextView
                        android:id="@+id/topWords2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.VBoard.Body" />
                    <TextView
                        android:id="@+id/topWords3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.VBoard.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
