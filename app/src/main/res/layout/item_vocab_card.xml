<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vocabCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="0dp">

    <!-- Use ConstraintLayout for proper aspect ratio -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Aspect Ratio Container (2:3 ratio like Stitch design) -->
        <View
            android:id="@+id/aspectRatio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Image/Emoji Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_emoji_container"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            app:layout_constraintBottom_toTopOf="@id/wordLabel"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/emojiText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝"
                android:textSize="48sp" />
        </LinearLayout>

        <!-- Word Label -->
        <TextView
            android:id="@+id/wordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:padding="@dimen/spacing_sm"
            android:text="Từ"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:importantForAccessibility="yes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/aspectRatio" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
