<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vb_system_background">

    <!-- Top App Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vb_topappbar_height"
        android:background="@color/vb_secondary_system_background">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/vb_space_md"
            android:paddingEnd="@dimen/vb_space_md">
            <TextView
                android:id="@+id/btnHeaderBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="start|center_vertical"
                android:textColor="@color/vb_accent"
                android:textSize="14sp"
                android:textFontWeight="500"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="‹ Lùi"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.VBoard.Headline"
                android:textColor="@color/vb_label"
                android:text="Xác minh PIN" />
            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vb_hairline"
            android:layout_gravity="bottom"
            android:background="@color/vb_separator" />
    </FrameLayout>

    <Space android:layout_width="match_parent" android:layout_height="@dimen/vb_space_2xl" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textAppearance="@style/TextAppearance.VBoard.Overline"
        android:text="CÂU HỎI" />

    <TextView
        android:id="@+id/mathQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/vb_space_xs"
        android:textAppearance="@style/TextAppearance.VBoard.Title1"
        android:textColor="@color/vb_label"
        tools:text="4 + 5 = ?" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/vb_space_xl"
        android:orientation="horizontal">

        <View android:id="@+id/dot1" android:layout_width="@dimen/vb_pin_dot" android:layout_height="@dimen/vb_pin_dot"
            android:layout_marginEnd="@dimen/vb_space_md"
            android:background="@drawable/bg_pin_dot_empty" />
        <View android:id="@+id/dot2" android:layout_width="@dimen/vb_pin_dot" android:layout_height="@dimen/vb_pin_dot"
            android:layout_marginEnd="@dimen/vb_space_md"
            android:background="@drawable/bg_pin_dot_empty" />
        <View android:id="@+id/dot3" android:layout_width="@dimen/vb_pin_dot" android:layout_height="@dimen/vb_pin_dot"
            android:layout_marginEnd="@dimen/vb_space_md"
            android:background="@drawable/bg_pin_dot_empty" />
        <View android:id="@+id/dot4" android:layout_width="@dimen/vb_pin_dot" android:layout_height="@dimen/vb_pin_dot"
            android:background="@drawable/bg_pin_dot_empty" />
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginBottom="@dimen/vb_space_2xl">

        <Button android:id="@+id/btn1" style="@style/Widget.VBoard.NumpadButton" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/Widget.VBoard.NumpadButton" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/Widget.VBoard.NumpadButton" android:text="3" />
        <Button android:id="@+id/btn4" style="@style/Widget.VBoard.NumpadButton" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/Widget.VBoard.NumpadButton" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/Widget.VBoard.NumpadButton" android:text="6" />
        <Button android:id="@+id/btn7" style="@style/Widget.VBoard.NumpadButton" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/Widget.VBoard.NumpadButton" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/Widget.VBoard.NumpadButton" android:text="9" />

        <Button android:id="@+id/btnCancel" style="@style/Widget.VBoard.NumpadButton.Plain" android:text="Huỷ" />
        <Button android:id="@+id/btn0"      style="@style/Widget.VBoard.NumpadButton" android:text="0" />
        <Button android:id="@+id/btnBackspace" style="@style/Widget.VBoard.NumpadButton.Plain" android:text="⌫" />
    </GridLayout>
</LinearLayout>
