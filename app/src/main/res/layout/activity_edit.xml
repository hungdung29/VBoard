<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vb_system_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vb_topappbar_height"
            android:background="@color/vb_secondary_system_background">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md">
                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="start|center_vertical"
                    android:textColor="@color/vb_accent"
                    android:textSize="14sp"
                    android:textFontWeight="500"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Huỷ"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/edit_title"
                    android:textAppearance="@style/TextAppearance.VBoard.Headline"
                    android:textColor="@color/vb_label" />
                <TextView
                    android:id="@+id/btnDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="end|center_vertical"
                    android:textColor="@color/vb_accent"
                    android:textSize="14sp"
                    android:textFontWeight="600"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/action_done"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/vb_hairline"
                android:layout_gravity="bottom"
                android:background="@color/vb_separator" />
        </FrameLayout>

        <!-- Folder Tabs -->
        <HorizontalScrollView
            android:id="@+id/folderScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vb_secondary_system_background"
            android:scrollbars="none"
            android:paddingStart="@dimen/vb_space_md"
            android:paddingEnd="@dimen/vb_space_md"
            android:paddingTop="@dimen/vb_space_xs"
            android:paddingBottom="@dimen/vb_space_xs">
            <LinearLayout
                android:id="@+id/folderContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vb_hairline"
            android:background="@color/vb_separator" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vocabGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/vb_space_xs"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="@integer/vb_edit_columns" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddFolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/vb_space_md"
        android:layout_marginBottom="@dimen/vb_space_xl"
        app:fabSize="mini"
        android:contentDescription="Thêm thư mục"
        app:srcCompat="@drawable/vb_ic_palette"
        app:backgroundTint="@color/vb_secondary_system_background"
        app:tint="@color/vb_accent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/vb_space_md"
        android:layout_marginBottom="@dimen/vb_space_md"
        android:contentDescription="Thêm thẻ mới"
        app:srcCompat="@drawable/vb_ic_add"
        app:backgroundTint="@color/vb_accent"
        app:tint="@android:color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
