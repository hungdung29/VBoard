<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vb_system_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vb_topappbar_height"
        android:background="@color/vb_secondary_system_background">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/vb_space_md"
            android:paddingEnd="@dimen/vb_space_md">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lùi"
                android:src="@drawable/vb_ic_chevron_left"
                app:tint="@color/vb_accent" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.VBoard.Headline"
                android:textColor="@color/vb_label" />
            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="end|center_vertical"
                android:textColor="@color/vb_accent"
                android:textSize="14sp"
                android:textFontWeight="500"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/action_close"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="@dimen/vb_hairline"
            android:layout_gravity="bottom" android:background="@color/vb_separator" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/vb_space_xl">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/vb_ic_lock"
            app:tint="@color/vb_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vb_space_md"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.VBoard.Title3"
            android:textColor="@color/vb_label"
            android:text="Vùng dành cho phụ huynh" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vb_space_xs"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.VBoard.Body"
            android:textColor="@color/vb_secondary_label"
            android:text="Vui lòng nhập mã PIN để vào cài đặt" />

        <Button
            android:id="@+id/btnOpenPin"
            style="@style/Widget.VBoard.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vb_space_xl"
            android:text="Nhập mã PIN" />
    </LinearLayout>
</LinearLayout>
