<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vb_system_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vb_topappbar_height"
        android:background="@color/vb_secondary_system_background">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/vb_space_md"
            android:paddingEnd="@dimen/vb_space_md">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lùi"
                android:src="@drawable/vb_ic_chevron_left"
                app:tint="@color/vb_accent" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/voice_settings_title"
                android:textAppearance="@style/TextAppearance.VBoard.Headline"
                android:textColor="@color/vb_label" />
            <View android:layout_width="44dp" android:layout_height="44dp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="@dimen/vb_hairline"
            android:layout_gravity="bottom" android:background="@color/vb_separator" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Volume -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md"
                android:paddingTop="@dimen/vb_space_md"
                android:paddingBottom="@dimen/vb_space_xs"
                android:textAppearance="@style/TextAppearance.VBoard.Overline"
                android:text="ÂM LƯỢNG" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vb_space_md"
                android:layout_marginEnd="@dimen/vb_space_md"
                app:cardBackgroundColor="@color/vb_secondary_system_background"
                app:cardCornerRadius="@dimen/vb_radius_md"
                app:cardElevation="@dimen/vb_elevation_e1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/vb_space_md">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/vb_ic_volume_down"
                        app:tint="@color/vb_secondary_label" />
                    <SeekBar
                        android:id="@+id/volumeSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vb_space_sm"
                        android:layout_marginEnd="@dimen/vb_space_sm"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100" />
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/vb_ic_volume_up"
                        app:tint="@color/vb_label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Voice type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md"
                android:paddingTop="@dimen/vb_space_md"
                android:paddingBottom="@dimen/vb_space_xs"
                android:textAppearance="@style/TextAppearance.VBoard.Overline"
                android:text="LOẠI GIỌNG" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vb_space_md"
                android:layout_marginEnd="@dimen/vb_space_md"
                app:cardBackgroundColor="@color/vb_secondary_system_background"
                app:cardCornerRadius="@dimen/vb_radius_md"
                app:cardElevation="@dimen/vb_elevation_e1">
                <RadioGroup
                    android:id="@+id/voiceTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/radioMaleNorth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/vb_space_md"
                        android:textAppearance="@style/TextAppearance.VBoard.Body"
                        android:textColor="@color/vb_label"
                        android:text="Nam · miền Bắc" />
                    <RadioButton
                        android:id="@+id/radioMaleSouth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/vb_space_md"
                        android:textAppearance="@style/TextAppearance.VBoard.Body"
                        android:textColor="@color/vb_label"
                        android:text="Nam · miền Nam" />
                    <RadioButton
                        android:id="@+id/radioFemaleNorth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/vb_space_md"
                        android:textAppearance="@style/TextAppearance.VBoard.Body"
                        android:textColor="@color/vb_label"
                        android:text="Nữ · miền Bắc" />
                    <RadioButton
                        android:id="@+id/radioFemaleSouth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/vb_space_md"
                        android:textAppearance="@style/TextAppearance.VBoard.Body"
                        android:textColor="@color/vb_label"
                        android:text="Nữ · miền Nam" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preview button -->
            <Button
                android:id="@+id/btnPreview"
                style="@style/Widget.VBoard.Button.Tinted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vb_space_md"
                android:layout_marginEnd="@dimen/vb_space_md"
                android:layout_marginTop="@dimen/vb_space_md"
                android:text="@string/voice_preview" />

            <!-- Voice clone (future) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/vb_space_md"
                android:paddingEnd="@dimen/vb_space_md"
                android:paddingTop="@dimen/vb_space_md"
                android:paddingBottom="@dimen/vb_space_xs"
                android:textAppearance="@style/TextAppearance.VBoard.Overline"
                android:text="AI VOICE (SẮP CÓ)" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vb_space_md"
                android:layout_marginEnd="@dimen/vb_space_md"
                android:layout_marginBottom="@dimen/vb_space_md"
                android:alpha="0.5"
                app:cardBackgroundColor="@color/vb_secondary_system_background"
                app:cardCornerRadius="@dimen/vb_radius_md"
                app:cardElevation="@dimen/vb_elevation_e1">
                <LinearLayout
                    android:id="@+id/btnVoiceClone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/vb_space_md">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/vb_ic_microphone"
                        app:tint="@color/vb_info" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/vb_space_md"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.VBoard.Body"
                            android:textFontWeight="500"
                            android:text="@string/voice_clone" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.VBoard.Caption1"
                            android:text="Ghi 30 giây để tạo giọng AI" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
